<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body>
    <div
      class="w-full min-h-screen bg-zinc-900 flex items-center justify-center p-4"
    >
      <div
        class="w-full max-w-lg bg-zinc-800 p-6 sm:p-8 rounded-2xl shadow-2xl"
      >
        <!-- Logout Button -->
        <div class="flex justify-end mb-6">
          <a
            href="/logout"
            class="bg-red-500 hover:bg-red-600 text-white rounded-lg px-4 py-2 text-sm font-medium transition"
          >
            Logout
          </a>
        </div>

        <h3 class="text-zinc-400 text-center mb-6">Edit your post here</h3>

        <!-- Create Post Form -->
        <form
          action="/update/<%= post._id %>"
          method="post"
          class="flex flex-col gap-4"
        >
          <textarea
            name="content"
            placeholder="What's on your mind?"
            rows="5"
            required
            class="w-full resize-y rounded-xl bg-zinc-700 border border-zinc-600 p-4 text-white placeholder-zinc-400 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 transition"
            name="content"
          >
 
          <%= post.content %>
        </textarea
          >

          <input
            type="submit"
            value="Update Post"
            class="w-full bg-yellow-600 text-black font-semibold py-3 rounded-xl cursor-pointer transition"
          />
        </form>
      </div>
    </div>
  </body>
</html>
