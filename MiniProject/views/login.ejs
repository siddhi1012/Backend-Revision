<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div
      class="w-full min-h-screen bg-zinc-900 flex items-center justify-center p-4"
    >
      <form
        action="/login"
        method="post"
        class="w-full max-w-md bg-zinc-800 p-8 rounded-xl flex flex-col gap-4"
      >
        <h1 class="text-3xl font-bold text-white text-center mb-4">
          Login Your Account
        </h1>

        <input
          type="email"
          placeholder="Email"
          name="email"
          class="w-full px-4 py-3 bg-zinc-700 text-white placeholder-zinc-400 rounded-lg outline-none focus:ring-2 focus:ring-blue-500"
        />

        <input
          type="password"
          placeholder="Password"
          name="password"
          class="w-full px-4 py-3 bg-zinc-700 text-white placeholder-zinc-400 rounded-lg outline-none focus:ring-2 focus:ring-blue-500"
        />

        <input
          type="submit"
          value="Login Account"
          class="w-full py-3 mt-2 bg-blue-600 text-white font-semibold rounded-lg cursor-pointer hover:bg-blue-700 transition-colors"
        />
      </form>
    </div>
  </body>
</html>
