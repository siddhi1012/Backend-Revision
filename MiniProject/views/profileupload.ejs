<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Upload</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body class="min-h-screen bg-zinc-900 flex items-center justify-center p-4">
    <div
      class="w-full max-w-md bg-zinc-800 border border-zinc-700 rounded-2xl p-8 shadow-2xl"
    >
      <h1 class="text-2xl font-bold text-white text-center mb-2">
        Upload Profile Picture
      </h1>

      <form
        action="/upload"
        enctype="multipart/form-data"
        method="post"
        class="flex flex-col gap-6"
      >
        <div class="flex flex-col gap-4">
          <label for="uploaded_file" class="text-sm font-medium text-zinc-300">
            Choose a file
          </label>

          <input
            type="file"
            id="uploaded_file"
            name="image"
            required
            class="w-full text-sm text-zinc-300 file:mr-4 file:rounded-lg file:border-0 file:bg-yellow-500 file:px-4 file:py-3 file:font-semibold file:text-black hover:file:bg-yellow-400 file:cursor-pointer cursor-pointer"
          />
        </div>

        <input
          type="submit"
          value="Get Me the Stats!"
          class="w-full bg-yellow-500 hover:bg-yellow-400 text-black font-semibold py-3 rounded-xl cursor-pointer transition duration-200"
        />
      </form>
    </div>
  </body>
</html>
